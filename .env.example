# ============================================
# AVENTIS LEADS — environment variables
# Copy this to .env.local for development.
# Add these in Netlify → Site settings → Env vars for production.
# ============================================

# --- Supabase (database) ---
# Create a free project at https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Anthropic Claude (deep research + scoring) ---
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7

# --- Twilio (SMS notifications) ---
# https://console.twilio.com — Phone Numbers + Messaging
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_PHONE=+1XXXXXXXXXX
NOTIFY_TO_PHONE=+1XXXXXXXXXX

# --- Resend (email backup notifications) ---
# https://resend.com
RESEND_API_KEY=re_...
NOTIFY_TO_EMAIL=isaiahwright2133@gmail.com
NOTIFY_FROM_EMAIL=leads@aventismarketing.com

# --- Google Custom Search (optional but recommended) ---
# https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Reddit (free — no key required for public JSON, but auth gives higher limits) ---
# Optional: https://www.reddit.com/prefs/apps (create a "script" app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AventisLeadsBot/1.0

# --- ScraperAPI (optional — for sites that block) ---
# https://www.scraperapi.com
SCRAPER_API_KEY=

# --- Security ---
# Use any long random string — protects the manual-run endpoint
CRON_SECRET=

# --- Site config ---
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
TIMEZONE=America/New_York

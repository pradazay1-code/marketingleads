# ============================================
# AVENTIS LEADS — environment variables
# Copy this to .env.local for development.
# Add these in Netlify → Site settings → Env vars for production.
#
# Everything below is 100% FREE — no credit card needed for any of it.
# ============================================

# --- Supabase (database — FREE) ---
# Create a free project at https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- AI provider (FREE — pick one or set both for failover) ---
# Default provider — "gemini" or "groq"
AI_PROVIDER=gemini

# Google Gemini — FREE: 1,500 requests/day, no credit card
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq — FREE, super fast Llama 3.3 70B
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Phone push notifications (FREE) ---
# OPTION 1: ntfy.sh — easiest, NO account needed
# 1. Install "ntfy" app on your phone (iOS/Android)
# 2. Pick a long random topic (= your "password"). Anyone with it can send you notifications.
# 3. Subscribe to that exact topic in the app
# 4. Set NTFY_TOPIC to the same string
NTFY_TOPIC=aventis-leads-isaiah-CHANGE-THIS-TO-LONG-RANDOM-STRING
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# OPTION 2: Telegram — also free, richer formatting + tap buttons
# 1. Telegram → @BotFather → /newbot → save token
# 2. Telegram → @userinfobot → /start → it gives you your numeric chat ID
# 3. Send any message to your new bot so it can reply
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email backup (FREE) ---
# Resend — free for 3,000 emails/month — https://resend.com
RESEND_API_KEY=re_...
NOTIFY_TO_EMAIL=isaiahwright2133@gmail.com
NOTIFY_FROM_EMAIL=leads@aventismarketing.com

# --- Google Custom Search (optional, FREE 100/day) ---
# https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Reddit (FREE — no key required for public JSON) ---
# Optional auth for higher rate limits: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AventisLeadsBot/1.0

# --- Twitter/X (optional, free tier exists) ---
# https://developer.x.com — free tier OK for ~500k tweets/mo
TWITTER_BEARER_TOKEN=

# --- ProductHunt (optional, FREE) ---
# https://api.producthunt.com/v2/oauth/applications
PRODUCTHUNT_TOKEN=

# --- OpenCorporates (optional, free tier) ---
OPENCORPORATES_API_TOKEN=

# --- ScraperAPI (optional, only if Indeed blocks you) ---
SCRAPER_API_KEY=

# --- Security ---
# Use any long random string — protects the manual-run endpoint
CRON_SECRET=

# --- Site config ---
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
TIMEZONE=America/New_York
